# Paths and ports of the Coxia service. Read by systemd (EnvironmentFile=) and by the coxia-server command.
# Plain KEY=value lines: no quotes, no spaces, no secrets (the master key is a file, named here, never a value).

# Everything the cores keep: the workspace registry and one folder per workspace. Back it up; it is useless without the master key.
COXIA_DATA_DIR=/var/lib/coxia/data

# The supervisor's own small files (port assignment, status). Outside the data folder on purpose.
COXIA_STATE_DIR=/var/lib/coxia/state

# The key that protects the secrets in the data folder. It must stay outside COXIA_DATA_DIR and out of its backups.
COXIA_MASTER_KEY_FILE=/etc/coxia/master.key

# A link to the active release (see updates below); the supervisor runs <COXIA_DIR>/out/headless/coxia.mjs.
COXIA_DIR=/opt/coxia/app

# The web client the cores serve.
COXIA_RENDERER_DIR=/opt/coxia/app/out/renderer

# The first port given to a workspace; the next ones follow. They listen on 127.0.0.1 only.
COXIA_BASE_PORT=8800

# The public address of each workspace served behind a reverse proxy, as workspace=url pairs separated by commas. The web settings are one for
# the whole data folder, so without this every workspace answers only for the address saved there (and for localhost). Needs a core that has
# --public-url. Read when the service starts.
# COXIA_PUBLIC_URLS=principal=https://coxia.example.com/cerimonias/,second=https://coxia-second.example.com/cerimonias/

# --- updates ---
# Which versions the timer follows: beta (every beta and every release), stable (releases only) or off. `coxia-server update --now` ignores off.
COXIA_UPDATE_CHANNEL=beta

# How long a new version is watched after it starts; if it fails in that time the instance goes back to the previous version and its data.
COXIA_UPDATE_HEALTH_MINUTES=5

# The public repository whose tags (v*.*.*) are the versions.
COXIA_REPO_URL=https://github.com/exatasmente/coxia.git

# Each version is built into <releases>/<version>; COXIA_DIR above is a link to the active one. The two newest snapshots of the data folder are kept
# in <snapshots> (outside the data folder, owned by root). Both are made by the install script.
COXIA_RELEASES_DIR=/opt/coxia/releases
COXIA_SNAPSHOTS_DIR=/var/lib/coxia/snapshots

# Tell the person with a line in each workspace's general thread after an update or a rollback; 0 leaves it to the journal and `coxia-server status`.
COXIA_UPDATE_NOTICE=1

# --- importing a workspace moved from another machine (`coxia-server import`) ---
# Where its repositories are cloned: <repos>/<workspace id>/<repo id>. The default is /var/lib/coxia/repos; it is inside the service's writable path.
# COXIA_REPOS_DIR=/var/lib/coxia/repos
